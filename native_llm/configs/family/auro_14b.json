  "deploy_profiles": ["gpu-server", "distributed-private-runtime"],
  "checkpoint_evidence_required": true,
  "purpose": "primary development and multi-embedded sub-agent orchestrator lane",
  "claim_boundary": "14B remains a training and orchestration lane until exact promoted checkpoint evidence exists",
  "required_receipts": ["tokenizer", "data_mixture", "pretrain_or_adaptation", "evaluation", "council_evaluation", "router_telemetry", "serving", "promotion"]
}
