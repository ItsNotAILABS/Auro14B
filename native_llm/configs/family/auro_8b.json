{
  "schema": "auro.native_llm.model_config.v2",
  "model_id": "Auro-8B",
  "family_id": "Auro",
  "status": "development-target-not-trained-checkpoint",
  "parameter_target": 8000000000,
  "tier": "general",
  "model_class": "core",
  "architecture": {
    "family": "decoder-only-transformer",
    "objective": "causal-language-modeling",
    "hidden_size": 4096,
    "layers": 32,
    "attention_heads": 32,
    "kv_heads": 8,
    "intermediate_size": 14336,
    "activation": "silu",
    "normalization": "rmsnorm",
    "position_encoding": "rope",
    "attention_type": "gqa",
    "context_window_tokens_target": 32768,
    "vocab_size_target": 128000,
    "experts": 16,
    "top_k": 4,
    "moe_every": 2
  },
  "subagent_roles": ["reason", "plan", "critique", "spectral_explain"],
  "capabilities": ["general_reasoning", "planning", "critique", "spectral_explanation", "multi-domain_synthesis"],
  "can_embed_subagents": true,
  "embeddable_tiers": ["atomic", "edge", "specialist"],
  "deploy_profiles": ["workstation", "server"],
  "checkpoint_evidence_required": true,
  "purpose": "general reasoning lane with embedded atomic, edge and specialist councils",
  "claim_boundary": "context and MoE fields are architecture targets; long-context and routing quality require exact-checkpoint evaluation",
  "required_receipts": ["tokenizer", "data_mixture", "pretrain_or_adaptation", "evaluation", "router_telemetry", "serving", "promotion"]
}
